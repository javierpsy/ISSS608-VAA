      <aliases enabled='yes' />
      <column caption='UCL' datatype='real' name='[Calculation_1370553294155776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([Sales])) + WINDOW_STDEV(SUM([Sales])) * [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Out of Control Limit' datatype='real' name='[Calculation_1370553298345986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Sales])&gt; [Calculation_1370553294155776] OR SUM([Sales]) &lt; [UCL (copy)_1370553295556609]&#13;&#10;THEN SUM([Sales])&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Gain or Lost' datatype='string' name='[Calculation_1370553313533955]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF {FIXED[Sub-Category]: SUM(IF DATEPART(&apos;year&apos;,&#13;&#10;[Order Date])= 2025 THEN [Sales] END)} &gt;&#13;&#10;    {FIXED[Sub-Category]: SUM(IF DATEPART(&apos;year&apos;, &#13;&#10;[Order Date]) = 2022 THEN [Sales] END)}&#13;&#10;THEN &quot;Gain&quot; ELSE &quot;Loss&quot; END' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country/Region]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[Postal Code]' role='dimension' semantic-role='[ZipCode].[Name]' type='nominal' />
      <column datatype='integer' name='[Row ID]' role='dimension' type='ordinal' />
      <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
      <column datatype='string' name='[State/Province]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
      <column caption='LCL' datatype='real' name='[UCL (copy)_1370553295556609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([Sales])) - WINDOW_STDEV(SUM([Sales])) * [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orders' datatype='table' name='[__tableau_internal_object_id__].[Orders_049F191F26FB41F08B4643903C0657B7]' role='measure' type='quantitative' />
