          <datasource-dependencies datasource='federated.0vy6g0s1yvfcyf122xvb30a8meg5'>
            <column caption='UCL' datatype='real' name='[Calculation_1370553294155776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(SUM([Sales])) + WINDOW_STDEV(SUM([Sales])) * [Parameters].[Parameter 1]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Out of Control Limit' datatype='real' name='[Calculation_1370553298345986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Sales])&gt; [Calculation_1370553294155776] OR SUM([Sales]) &lt; [UCL (copy)_1370553295556609]&#13;&#10;THEN SUM([Sales])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
